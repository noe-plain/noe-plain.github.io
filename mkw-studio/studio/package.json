{
  "name": "mkw-sujet-studio",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build:browser": "node build/browser.mjs",
    "build:psd": "esbuild build/psd-entry.js --bundle --minify --format=iife --global-name=agPsd --outfile=static/vendor/ag-psd.js",
    "test": "node --test tests/*.test.js",
    "build:assets": "node build/version-assets.mjs",
    "build:pdf": "esbuild build/pdf-entry.js --bundle --minify --format=iife --global-name=MKWPDF --outfile=static/vendor/pdf.js",
    "test:browser": "node tests/run-browser.mjs",
    "format": "prettier --write \"static/*.js\" \"static/*.css\" \"build/*.js\" \"build/*.mjs\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"static/*.js\" \"static/*.css\" \"build/*.js\" \"build/*.mjs\" --ignore-path .prettierignore",
    "build:editor": "node build/editor.mjs",
    "build": "node build/version-assets.mjs && npm run build:editor && node build/version-assets.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "@pdf-lib/fontkit": "1.1.1",
    "ag-psd": "28.4.1",
    "pdf-lib": "1.17.1",
    "upng-js": "2.1.0"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.58.2",
    "prettier": "3.6.2"
  }
}
